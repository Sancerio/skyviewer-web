{
  "name": "skyviewer-web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write src/*.ts src/*.tsx src/*.css *.ts docs/*.md README.md",
    "format:check": "prettier --check src/*.ts src/*.tsx src/*.css *.ts docs/*.md README.md",
    "catalog": "node scripts/compact-catalog.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "astronomy-engine": "2.1.19",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "latest",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vite": "8.3.0",
    "vitest": "latest"
  },
  "engines": {
    "node": ">=22.12"
  }
}
